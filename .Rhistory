"HousingSubsidy_clean", "df04_DC", "integer", "HousingSubsidyCode with sentinels 8/9 set to NA",
"DwellingCoditionsScore", "Engineered", "integer", "0-3 composite: wall + roof + floor conditions",
"HouseholdID",           "All 4 files",  "character","Household identifier; join key",
"Province_clean",        "df05_BS",      "character","Standardised province name (9 categories)",
"GeoTypeCode",           "df05_BS",      "integer",  "Urban/rural/informal classification, as supplied",
"HouseholdWeight",       "df05_BS",      "numeric",  "Survey weight, as supplied",
"WaterSafe_label",       "df05_BS",      "factor",   "Recoded from WaterSafeCode ",
"MainToiletCode_clean",  "df05_BS",      "integer",  "MainToiletCode with invalid 99 set to NA ",
"ElectricityAccess_label","df06_HE",     "factor",   "Recoded from ElectricityAccessCode ",
"LoadsheddingFrequencyCode","df06_HE",   "integer",  "As supplied",
"HouseholdSize_clean",   "Df07_HW",      "integer",  "HouseholdSize with 0 set to NA ",
"Income_clean",          "Df07_HW",      "numeric",  "TotalMonthlyHouseholdIncomeRaw with >=9,999,999 set to NA",
"AdultHungerCode",       "Df07_HW",      "integer",  "As supplied",
