Dataset = c("df05_BS", "df06_HE", "Df07_HW","df09_HR"),
Full_row_duplicates = c(sum(duplicated(df05_BS)), sum(duplicated(df06_HE)),
sum(duplicated(Df07_HW)), sum(duplicated(df09_HR)))
)
